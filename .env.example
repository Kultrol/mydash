# mydash environment (MVP)
# Copy this file to `.env` and fill in values. Never commit `.env`.
#
# Weather (Open-Meteo) and news (Noozra) need no API keys.
# Markets (Alpaca) require free API credentials — see README "Environment setup".

# Alpaca Markets — required for the stocks / markets panel
# Get keys: https://alpaca.markets/ (paper trading keys work for market data)
STOCK_ALPACA_API_KEY_ID=your_alpaca_key_id
STOCK_ALPACA_API_SECRET_KEY=your_alpaca_secret
