# Copy to .env.local for local development (never commit .env.local).
#
# FastAPI base URL — no trailing slash.
# Start the API later with:
#   uv run uvicorn mydash.api.main:app --reload --port 8000
#
# On Vercel: set the same key under Project → Settings → Environment Variables
# once you have a publicly reachable API host.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
